{
  "name": "taskwarrior-api",
  "version": "0.1.3",
  "description": "A simple API for Taskwarrior",
  "license": "MIT",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsup src/server.ts --format esm --clean --dts",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest --runInBand --detectOpenHandles --forceExit"
  },
  "keywords": [],
  "author": "Sief Ali",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sief-Ali/taskwarrior-api.git"
  },
  "homepage": "https://github.com/Sief-Ali/taskwarrior-api#readme",
  "bugs": {
    "url": "https://github.com/Sief-Ali/taskwarrior-api/issues"
  },
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "taskwarrior-adapter": "^0.2.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "ts-jest": "^29.4.15",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0"
  }
}
